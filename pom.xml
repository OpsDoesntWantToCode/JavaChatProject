<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.chatapp</groupId>
    <artifactId>JavaChatProject</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>Java Chat System</name>
    <description>He thong Chat Desktop Java Swing + FlatLaf, CSDL PostgreSQL, TCP Socket</description>

    <properties>
        <!-- Ma hoa ky tu chuan UTF-8 -->
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Phien ban Java 21 LTS theo quy chuan AGENTS.md & tech-stack.md -->
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <java.version>21</java.version>

        <!-- Phien ban cac thu vien chinh thuc (Tech Stack Da Chot) -->
        <flatlaf.version>3.5.4</flatlaf.version>
        <jfreechart.version>1.5.5</jfreechart.version>
        <gson.version>2.11.0</gson.version>
        <postgresql.version>42.7.4</postgresql.version>
        <jbcrypt.version>0.4</jbcrypt.version>
        <jakarta.mail.version>2.1.3</jakarta.mail.version>
        <angus.mail.version>2.0.3</angus.mail.version>
    </properties>

    <dependencies>
        <!-- 1. Giao dien Look and Feel hien dai: FlatLaf (Phuc vu ca User UI va Admin UI) -->
        <dependency>
            <groupId>com.formdev</groupId>
            <artifactId>flatlaf</artifactId>
            <version>${flatlaf.version}</version>
        </dependency>

        <!-- 2. Bieu do thong ke Admin: JFreeChart (Bieu do dang ky & nguoi dung hoat dong) -->
        <dependency>
            <groupId>org.jfree</groupId>
            <artifactId>jfreechart</artifactId>
            <version>${jfreechart.version}</version>
        </dependency>

        <!-- 3. Dong goi & Phan tich du lieu JSON qua TCP Socket: Google Gson -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <version>${gson.version}</version>
        </dependency>

        <!-- 4. Ket noi Co so du lieu PostgreSQL: pgJDBC Driver -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>${postgresql.version}</version>
        </dependency>

        <!-- 5. Bao mat: Bam mat khau bang BCrypt -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>${jbcrypt.version}</version>
        </dependency>

        <!-- 6. Gui Email SMTP khoi tao mat khau: Jakarta Mail API + Angus Implementation -->
        <dependency>
            <groupId>jakarta.mail</groupId>
            <artifactId>jakarta.mail-api</artifactId>
            <version>${jakarta.mail.version}</version>
        </dependency>
        <dependency>
            <groupId>org.eclipse.angus</groupId>
            <artifactId>jakarta.mail</artifactId>
            <version>${angus.mail.version}</version>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Dinh cau truc thu muc ma nguon cua du an -->
        <sourceDirectory>src</sourceDirectory>

        <plugins>
            <!-- Plugin bien dich ma nguon Java 21 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <source>${maven.compiler.source}</source>
                    <target>${maven.compiler.target}</target>
                    <encoding>${project.build.sourceEncoding}</encoding>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>

